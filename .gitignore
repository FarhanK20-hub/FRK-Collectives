# WHAT IS INTENTIONALLY INCLUDED
# .env.example - Template for environment variables to help new developers set up
# pom.xml - Maven project object model, required for dependencies and build
# src/ - All source code, including Java, JSP, CSS, JS
# README.md - Project documentation

# ==========================================
# 1. Security critical files
# ==========================================
# NEVER COMMIT REAL CREDENTIALS
.env
*.pem
*.key
*.p12
*.keystore
credentials.json
secrets.yml

# ==========================================
# 2. Dependencies and packages
# ==========================================
# Maven resolves these dynamically; no need to track downloaded jars
dependency-reduced-pom.xml
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 3. Build and compile output
# ==========================================
# Generated by `mvn clean compile` or `mvn clean package`
target/
*.class
*.war
*.jar
*.ear

# ==========================================
# 4. Runtime logs and debug files
# ==========================================
*.log
logs/
hs_err_pid*
replay_pid*

# ==========================================
# 5. IDE and OS generated files
# ==========================================
# IntelliJ IDEA
.idea/
*.iml
*.iws

# Eclipse
.project
.classpath
.settings/
.metadata/

# VS Code
.vscode/
*.code-workspace

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# 6. Local database files
# ==========================================
# If running an embedded DB or SQLite for testing
*.sqlite
*.db

# ==========================================
# 7. Tool-specific files
# ==========================================
# Catalina / Tomcat specific
catalina.out
work/
temp/
