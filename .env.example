# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# [REQUIRED] The JDBC connection URL for the MySQL database.
# Format: jdbc:mysql://[host]:[port]/[database_name]?useSSL=[true|false]
DB_URL=jdbc:mysql://localhost:3306/frk_collectives_db?useSSL=false&serverTimezone=UTC

# [REQUIRED] The database user account name.
DB_USER=root

# [SECRET - never commit the real value] [REQUIRED] 
# The password for the database user account. 
# You should create a dedicated database user rather than using root in production.
DB_PASSWORD=your_secure_database_password_here

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# [OPTIONAL - default: 8080] The port the application server runs on.
APP_PORT=8080

# [OPTIONAL - default: development] The environment the app is running in.
# Accepts: development, staging, production
APP_ENV=development

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================

# [SECRET - never commit the real value] [REQUIRED]
# Secret key used for signing session tokens or password hashing salts.
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=generate_a_random_32_byte_hex_string

# ==========================================
# THIRD-PARTY INTEGRATIONS (Mock)
# ==========================================

# [SECRET - never commit the real value] [OPTIONAL]
# Mock payment gateway API key for testing realistic transactions.
PAYMENT_GATEWAY_API_KEY=sk_test_mock_payment_key_12345
